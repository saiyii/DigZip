{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "digzip",
  "version-semver": "0.1.0",
  "builtin-baseline": "43930cd67eee1aac4e2becacdaf5f5bf62b3ed1e",
  "dependencies": [
    "zlib",
    {
      "name": "bzip2",
      "default-features": false
    },
    "liblzma",
    "zstd"
  ],
  "features": {
    "openssl": {
      "description": "OpenSSL from vcpkg, to build the OpenSSL crypto backend where the system has none",
      "dependencies": [
        "openssl"
      ]
    },
    "tests": {
      "description": "Unit and integration tests",
      "dependencies": [
        "catch2"
      ]
    }
  }
}
